# Copy to .env and load it with: set -a; . ./.env; set +a
# Environment variables carry no prefix. A double underscore nests keys:
# POSTGRES__HOST sets postgres.host. Variables without a double underscore are ignored.

# Logging (both binaries)
LOG__FORMAT=text
LOG__LEVEL=info
LOG__ADD_SOURCE=false

# PostgreSQL (both binaries)
POSTGRES__HOST=localhost
POSTGRES__PORT=5432
POSTGRES__USER=postgres
POSTGRES__PASSWORD=postgres
POSTGRES__DB=postgres
POSTGRES__SSL_MODE=disable
POSTGRES__MAX_CONNS=5
POSTGRES__MIN_CONNS=1
POSTGRES__MAX_CONN_LIFETIME=30m
POSTGRES__MAX_CONN_IDLE_TIME=5m

# Engine (cmd/runcoil only)
ENGINE__PORT=7070
# Required: the server has no default token. dev-token is for local development; replace it anywhere else.
ENGINE__TOKEN=dev-token
ENGINE__HEARTBEAT_INTERVAL=10s
ENGINE__LEASE_DURATION=30s
ENGINE__SEND_TIMEOUT=5s
ENGINE__SHUTDOWN_TIMEOUT=10s
# Default retry policy: tries in total, delay before each retry (comma-separated; the last one repeats), jitter.
ENGINE__RETRY__MAX_ATTEMPTS=4
ENGINE__RETRY__DELAYS=5s,10s,30s,1m,3m,10m,30m,1h
ENGINE__RETRY__JITTER=0.2
ENGINE__WORKER_WAIT_LIMIT=24h
ENGINE__INSTANCE_EVICTION_LEASES=3
# Idempotency keys: how long a caller's key is held.
ENGINE__IDEMPOTENCY__WINDOW=24h

# Schedule poller (engine.scheduler). Only the schedules due within the window are held in memory,
# at most max_loaded of them. A poll runs every poll_interval, which must not exceed the window.
ENGINE__SCHEDULER__WINDOW=30s
ENGINE__SCHEDULER__POLL_INTERVAL=10s
ENGINE__SCHEDULER__MAX_LOADED=10000

# Dispatch loop (engine.dispatcher). It also runs at once when a Run becomes ready.
ENGINE__DISPATCHER__POLL_INTERVAL=1s

# Sweep (engine.sweep): expires leases and worker waits, and enforces instance liveness.
ENGINE__SWEEP__INTERVAL=1s

# WaitRun (engine.wait_run): a request without a timeout waits max_timeout. The poll interval is the
# check of the store besides the wake-up signal. max_waiters is how many WaitRun calls may wait at once.
ENGINE__WAIT_RUN__MAX_TIMEOUT=60s
ENGINE__WAIT_RUN__POLL_INTERVAL=500ms
ENGINE__WAIT_RUN__MAX_WAITERS=1000

# Size limits in bytes (engine.limits)
ENGINE__LIMITS__INPUT_BYTES=1048576
ENGINE__LIMITS__STEP_OUTPUT_BYTES=1048576
ENGINE__LIMITS__RUN_OUTPUT_BYTES=1048576
ENGINE__LIMITS__RUN_TOTAL_BYTES=16777216

# Worker cleanup (cmd/runcoil only). The run retention must not be shorter than the idempotency window.
WORKER__CLEANUP__INTERVAL=1h
WORKER__CLEANUP__RUN_RETENTION=168h
